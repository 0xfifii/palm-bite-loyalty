# Palm Bite Loyalty environment variables.
# Copy to .env.local for local development, and add the same values in
# Vercel > Project > Settings > Environment Variables for production.

# Supabase project (Project Settings > API). The anon (or publishable) key is
# safe in the browser because Row Level Security protects every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role (or secret) key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the deployed app, without a trailing slash. Used in email
# links and inside the visit QR code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Country calling code used for local phone numbers that start with 0.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=234

# Secret used to sign visit QR codes. SERVER ONLY. At least 32 characters.
# Generate one with:  openssl rand -base64 48
QR_SIGNING_SECRET=

# Optional: the previous signing secret during a rotation, so codes already
# on screen keep working until they expire. Leave empty normally.
QR_SIGNING_SECRET_PREVIOUS=

# Salt for hashing IP addresses in rate limits and scan logs. SERVER ONLY.
# At least 16 characters. Generate with:  openssl rand -base64 24
RATE_LIMIT_SALT=

# The Palm Bite location created by the first migration. Change only if you
# add another location row and want this deployment to serve it.
PALM_BITE_LOCATION_ID=00000000-0000-4000-8000-000000000001
